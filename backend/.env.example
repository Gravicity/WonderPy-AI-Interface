# WonderPy AI-Interface Environment Configuration

# Application Settings
APP_NAME="WonderPy AI Interface"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
LOG_LEVEL="INFO"

# API Server
HOST="0.0.0.0"
PORT=8000
RELOAD=true

# Security
SECRET_KEY="your-secret-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL="postgresql://wonderpy:password@localhost:5432/wonderpy_db"
DB_ECHO=false

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Services
ANTHROPIC_API_KEY="sk-ant-your-key-here"
OPENAI_API_KEY="sk-your-key-here"

# Voice Services (Primary: Deepgram for robot-centric AI)
DEEPGRAM_API_KEY="your-deepgram-api-key-here"
PORCUPINE_ACCESS_KEY="your-picovoice-access-key-here"
VOICE_MODEL_STT="flux-general-en"  # flux-general-en or nova-3
VOICE_MODEL_TTS="aura-asteria-en"  # aura voice model
WAKE_WORD="hey dash"
VAD_ENABLED=true

# Voice Services (Alternative/Legacy)
ELEVENLABS_API_KEY="your-elevenlabs-key-here"
WHISPER_MODEL_SIZE="base"  # tiny, base, small, medium, large
WHISPER_DEVICE="cpu"  # cpu or cuda

# Robot Settings
ROBOT_SCAN_TIMEOUT=20
ROBOT_CONNECTION_TIMEOUT=30
SENSOR_UPDATE_RATE_HZ=30

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
